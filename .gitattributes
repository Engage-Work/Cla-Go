# Store text files as LF in the repo; checkout converts per platform automatically
* text=auto eol=lf

# Do not convert line endings for binary files
*.jpg binary
*.png binary
*.ico binary

# Language stats
*.html linguist-detectable=true
*.js   linguist-detectable=true
*.css  linguist-detectable=true
lib/three.min.js linguist-vendored=true

# Windows batch files must be CRLF
*.cmd text eol=crlf
